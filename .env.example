APP_NAME=CloudSentinel
APP_ENV=local
APP_KEY=
APP_DEBUG=true
APP_URL=http://localhost
APP_HOST=0.0.0.0
APP_PORT=3000

# 内嵌公开站点使用独立监听器；仅开放公开 SPA 与四个只读公开接口。
PUBLIC_HTTP_ENABLED=true
PUBLIC_HOST=0.0.0.0
PUBLIC_PORT=3001
# 留空时复用 TLS_CERT_FILE / TLS_KEY_FILE；不同域名可单独覆盖。
# PUBLIC_TLS_CERT_FILE=
# PUBLIC_TLS_KEY_FILE=

# Goravel 维护模式：单机默认使用 file；多实例可改为 cache 并指定 store。
APP_MAINTENANCE_DRIVER=file
# APP_MAINTENANCE_STORE=

# CORS 白名单来源（后端解析）：英文逗号`,`分隔多个来源；空项会被忽略，周围空格会被 trim。
# 留空时拒绝所有跨域浏览器请求；同源请求不受影响。
# CORS_ADMIN_ORIGINS=https://admin.example.com,https://admin2.example.com
# CORS_PUBLIC_ORIGINS=https://status.example.com,https://status2.example.com

JWT_SECRET=

LOG_CHANNEL=stack
LOG_LEVEL=debug

# Goravel HTTP 客户端（默认值通常无需修改）
HTTP_CLIENT_DEFAULT=default
HTTP_CLIENT_BASE_URL=
HTTP_CLIENT_TIMEOUT=30s
HTTP_CLIENT_MAX_IDLE_CONNS=100
HTTP_CLIENT_MAX_IDLE_CONNS_PER_HOST=2
HTTP_CLIENT_MAX_CONN_PER_HOST=0
HTTP_CLIENT_IDLE_CONN_TIMEOUT=90s
HTTP_CLIENT_GITHUB_BASE_URL=https://api.github.com
HTTP_CLIENT_GITHUB_TIMEOUT=30s
HTTP_CLIENT_DOWNLOAD_TIMEOUT=10m

DB_CONNECTION=sqlite
DB_DATABASE=database.db

SESSION_DRIVER=file
SESSION_LIFETIME=120

# 认证 Cookie 策略（管理员登录态与 CSRF Cookie 会复用这些配置）
# 开发环境若通过 http://IP:5177 访问管理端，建议保持 SESSION_SECURE=false，
# 否则浏览器会拒绝保存 Secure Cookie，表现为“登录成功但后续接口未认证、刷新后掉登录”。
# 生产环境建议启用 HTTPS，并设置 SESSION_SECURE=true。
# SESSION_PATH=/
# SESSION_DOMAIN=
# SESSION_SECURE=false
# SESSION_SAME_SITE=lax
