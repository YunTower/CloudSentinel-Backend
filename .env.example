APP_NAME=CloudSentinel
APP_ENV=local
APP_KEY=
APP_DEBUG=true
APP_URL=http://localhost
APP_HOST=0.0.0.0
APP_PORT=3000

# 逗号分隔的前端来源。留空时拒绝所有跨域浏览器请求；同源请求不受影响。
# CORS_ADMIN_ORIGINS=https://admin.example.com
# CORS_PUBLIC_ORIGINS=https://status.example.com

JWT_SECRET=

LOG_CHANNEL=stack
LOG_LEVEL=debug

DB_CONNECTION=sqlite
DB_DATABASE=database.db

SESSION_DRIVER=file
SESSION_LIFETIME=120
